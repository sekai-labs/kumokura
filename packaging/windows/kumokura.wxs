<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <?ifndef Version?>
        <?define Version = "0.1.0"?>
    <?endif?>

    <Product Id="*"
             Name="Kumokura"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="Sekai Labs"
             UpgradeCode="7A1C234E-0A1B-4C62-A8E2-263B72C899DE">

        <Package InstallerVersion="301"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="Kumokura - Native Cloud Object Storage Explorer (CLI, TUI, GUI)"
                 Comments="High-performance S3 storage manager in Go" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of Kumokura is already installed."
                      AllowSameVersionUpgrades="yes" />

        <MediaTemplate EmbedCab="yes" />

        <Feature Id="MainApplication" Title="Kumokura" Level="1">
            <ComponentGroupRef Id="AppFiles" />
            <ComponentGroupRef Id="AppShortcuts" />
            <ComponentGroupRef Id="AppEnvironment" />
        </Feature>
    </Product>

    <Fragment>
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="Kumokura" />
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="Kumokura" />
            </Directory>
        </Directory>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
            <Component Id="KumokuraCliExe" Guid="98C6D2B1-4A55-46D9-B6F1-2B8838AA11A1" Win64="yes">
                <File Id="KumokuraCliExeFile" Source="$(var.SourceDir)\kumokura.exe" KeyPath="yes" />
            </Component>
            <Component Id="KumokuraTuiExe" Guid="87E5A2A3-3B44-45C8-A7E0-1C77279922B2" Win64="yes">
                <File Id="KumokuraTuiExeFile" Source="$(var.SourceDir)\kumokura-tui.exe" KeyPath="yes" />
            </Component>
            <Component Id="KumokuraDesktopExe" Guid="76D49192-2C33-44B7-96DF-0D66168833C3" Win64="yes">
                <File Id="KumokuraDesktopExeFile" Source="$(var.SourceDir)\kumokura-desktop.exe" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="AppShortcuts">
            <Component Id="StartMenuShortcuts" Guid="65C38081-1D22-43A6-85DE-FE55057744D4" Directory="ApplicationProgramsFolder">
                <Shortcut Id="DesktopAppStartMenuShortcut"
                          Name="Kumokura"
                          Description="Kumokura Native Object Storage Explorer"
                          Target="[INSTALLFOLDER]kumokura-desktop.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <Shortcut Id="TuiAppStartMenuShortcut"
                          Name="Kumokura TUI"
                          Description="Kumokura Dual-Pane Terminal UI"
                          Target="[INSTALLFOLDER]kumokura-tui.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="CleanUpShortcuts" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\SekaiLabs\Kumokura" Name="installed" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>

    <Fragment>
        <ComponentGroup Id="AppEnvironment" Directory="INSTALLFOLDER">
            <Component Id="PathEnvironment" Guid="54B27F70-0C11-42B5-74CD-ED44F46655E5" Win64="yes">
                <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
                <RegistryValue Root="HKLM" Key="Software\SekaiLabs\Kumokura" Name="PathConfigured" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
